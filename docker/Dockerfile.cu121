FROM nvcr.io/nvidia/pytorch:23.07-py3

WORKDIR /root

RUN echo "LC_ALL=en_US.UTF-8" >> /etc/environment

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential git wget \
  libgtest-dev libprotobuf-dev protobuf-compiler libgflags-dev libsqlite3-dev llvm-dev \
  && apt-get clean autoclean && rm -rf /var/lib/apt/lists/{apt,dpkg,cache,log} /tmp/* /var/tmp/*

RUN wget https://repo.anaconda.com/miniconda/Miniconda3-py310_23.5.2-0-Linux-x86_64.sh -O install_miniconda.sh && \
  bash install_miniconda.sh -b -p /opt/conda && rm install_miniconda.sh

ENV PATH="/opt/conda/bin:${PATH}"

ENV LIBGL_ALWAYS_INDIRECT=1

RUN conda install -y -c conda-forge pip "cmake>=3.26.1" \
      gcc_linux-64=11 gxx_linux-64=11 libstdcxx-ng=12 \
  && conda clean --all --yes

ENV CC=/opt/conda/bin/x86_64-conda-linux-gnu-cc
ENV CXX=/opt/conda/bin/x86_64-conda-linux-gnu-c++

RUN apt-get install -y python3 python3-dev python3-setuptools gcc libtinfo-dev zlib1g-dev build-essential cmake libedit-dev libxml2-dev

# Build from the selected checkout with initialized submodules:
# docker build -f docker/Dockerfile.cu121 -t tilelang_workspace .
# The host compiler must support C++20 independently of the CUDA toolkit.
RUN python -m pip install uv "cmake>=3.26.1" "ninja>=1.11"
COPY . /root/TileLang
RUN cd /root/TileLang \
  && python maint/scripts/build_native_artifacts.py stage --destination /root/native-stage \
  && USE_CUDA=ON python maint/scripts/build_native_artifacts.py build \
       --stage /root/native-stage --output /root/native-dist --frontend uv \
       --wheel-only --install --jobs 4 \
  && uv pip install --python /opt/conda/bin/python --no-deps -e .

CMD bash
