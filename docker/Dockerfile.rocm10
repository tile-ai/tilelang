# TileLang on AMD ROCm (pip-SDK flavor).
#
# This image targets the newer rocm/pytorch images where ROCm 10.x ships as
# Python wheels (rocm-sdk / _rocm_sdk_devel) instead of a system /opt/rocm tree.
# There is no /opt/rocm here and no rocm-* apt packages; ROCm and a ROCm build
# of PyTorch are already provided by the base image. For classic /opt/rocm
# installs (ROCm 6/7) use docker/Dockerfile.rocm instead.
#
# Build from the tilelang repo root:
#   docker build -f docker/Dockerfile.rocm10 -t tilelang_rocm10:latest .
FROM rocm/pytorch:rocm10.1.0_ubuntu24.04_py3.12_pytorch_release_2.14.0

WORKDIR /root

RUN echo "LC_ALL=en_US.UTF-8" >> /etc/environment

ENV DEBIAN_FRONTEND=noninteractive

# Build toolchain only. ROCm/HIP itself comes from the base image as pip wheels
# (rocm-sdk), so we do NOT apt-install rocm-dev/rocm-libs/hip-dev/hipblas-dev/
# rocblas-dev -- those packages are not in this image's apt repos and ROCm is
# already present. git is required because version_provider.py runs `git` when a
# .git directory is present.
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential git wget cmake ninja-build \
  libgtest-dev libprotobuf-dev protobuf-compiler libgflags-dev libsqlite3-dev llvm-dev \
  python3 python3-dev python3-setuptools gcc libtinfo-dev zlib1g-dev libedit-dev libxml2-dev \
  && apt-get clean autoclean && rm -rf /var/lib/apt/lists/{cache,log} /tmp/* /var/tmp/*

ENV LIBGL_ALWAYS_INDIRECT=1
ENV USE_ROCM=1
ENV USE_CUDA=0
ENV HIP_PLATFORM=amd

# ROCm is a pip-SDK install, not /opt/rocm. Point ROCM_PATH at the SDK root so
# TileLang's hipcc discovery (tilelang/contrib/rocm.py) uses the complete
# toolchain and skips the "incomplete HIP toolchain" warning emitted for the
# PATH wrapper at /usr/local/bin/hipcc. The root is reported by
# `rocm-sdk path --root` and is stable for this image's Python 3.12.
ENV ROCM_PATH=/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel
ENV PATH=${ROCM_PATH}/bin:${PATH}
ENV PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx950;gfx1201;gfx1100"

# Copy local tilelang directory instead of cloning from git
COPY . /root/tilelang

# Build from source. torch is already provided by the base image (a ROCm build),
# so strip tilelang's torch pins to stop pip from pulling a different torch.
# At build time ROCm links via vendored HIP headers + hip_stub (no /opt/rocm
# needed); the real ROCm runtime from the base image is used at execution time.
RUN cd /root/tilelang && \
    cp pyproject.toml pyproject.toml.bak && \
    sed -i '/^[[:space:]]*\"torch/d' pyproject.toml && \
    USE_ROCM=1 USE_CUDA=0 pip install -e . -v && \
    mv pyproject.toml.bak pyproject.toml

# Build self-check: fail the image build early if the package cannot import.
# Run from /root (not the repo) so a broken install surfaces instead of silently
# importing the source tree.
RUN cd /root && python3 -c "import tilelang; print('tilelang', tilelang.__version__)"

SHELL ["/bin/bash", "-l", "-c"]

ENTRYPOINT ["/bin/bash", "--login", "-i"]
